# ==============================================
# CS2 P2P Skins Trading Platform - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values

# Application Environment
APP_ENV=dev                    # dev, staging, production
PORT=8443                      # HTTPS port (8443 for dev, 443 for production)

# TLS/SSL Configuration
# Paths to SSL certificate and private key (relative to backend/)
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key

# Database Configuration
DB_DSN=postgres://postgres:postgres123@localhost:5432/cs2p2p?sslmode=disable

# JWT Authentication
# Security: Use a strong random secret in production (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-strong-secret
JWT_EXPIRATION_HOURS=24        # Token expiration time in hours

# Steam OAuth Configuration
# Get your Steam API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your-steam-api-key-here
STEAM_CALLBACK_URL=https://localhost:8443/api/auth/steam/callback

# CORS Configuration
# Comma-separated list of allowed origins
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:3000

# External API Keys for /services/ endpoints
# Comma-separated list of API keys for external systems to access public services
# Generate secure keys with: openssl rand -hex 32
# Example: EXTERNAL_API_KEYS=sk_prod_abc123,sk_prod_def456
EXTERNAL_API_KEYS=your-api-key-here

# Redis Configuration (optional, for future caching/sessions)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis123

# ==============================================
# Security Notes:
# ==============================================
# 1. NEVER commit .env file to git
# 2. Use strong passwords and secrets in production
# 3. Enable HTTPS in production (update STEAM_CALLBACK_URL accordingly)
# 4. Rotate JWT_SECRET periodically
# 5. Keep STEAM_API_KEY confidential
# ==============================================
