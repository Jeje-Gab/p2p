meta {
  name: 1. List All Skins
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/skins?limit=50&offset=0
  body: none
  auth: bearer
}

params:query {
  limit: 50
  offset: 0
}

auth:bearer {
  token: {{token}}
}

docs {
  # List All Skins

  Returns paginated list of all available CS2 skins.

  ## Security:
  - Requires JWT authentication
  - Rate limited (30 req/min)

  ## Query Parameters:
  - `limit`: Number of results (default: 50, max: 100)
  - `offset`: Pagination offset (default: 0)

  ## Response:
  ```json
  {
    "success": true,
    "data": [
      {
        "id": 1,
        "name": "AK-47 | Redline",
        "type": "Rifle",
        "rarity": "Classified",
        "exterior": "Field-Tested",
        "market_price": 25.50,
        "image_url": "https://...",
        "created_at": "2025-11-16T10:00:00Z"
      }
    ]
  }
  ```
}
