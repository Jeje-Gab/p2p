meta {
  name: 2. Get Skin by ID
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/skins/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  # Get Skin by ID

  Returns detailed information about a specific skin.

  ## Security:
  - Requires JWT authentication

  ## Response:
  ```json
  {
    "success": true,
    "data": {
      "id": 1,
      "name": "AK-47 | Redline",
      "type": "Rifle",
      "rarity": "Classified",
      "exterior": "Field-Tested",
      "market_price": 25.50,
      "image_url": "https://...",
      "description": "The AK-47 is a powerful assault rifle...",
      "created_at": "2025-11-16T10:00:00Z"
    }
  }
  ```

  **Note:** Replace `1` in URL with actual skin ID
}
