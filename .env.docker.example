# ==========================================
# CS2 P2P Skins Trading Platform
# Docker Environment Variables
# ==========================================
# Copy this file to .env before running docker-compose

# ==========================================
# Application
# ==========================================
APP_ENV=production

# ==========================================
# Database (PostgreSQL)
# ==========================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_PORT=5432

# ==========================================
# Backend API
# ==========================================
BACKEND_PORT=8080

# TLS Configuration
TLS_ENABLED=false

# JWT Authentication
JWT_SECRET=my-super-secret-jwt-key-for-production-change-this-min-32-chars
JWT_EXPIRATION_HOURS=24

# Steam OAuth (REQUIRED - Get your key from: https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=YOUR_STEAM_API_KEY_HERE
STEAM_CALLBACK_URL=http://localhost:8080/api/auth/steam/callback
FRONTEND_URL=http://localhost:3000

# CORS
ALLOW_ORIGINS=http://localhost:3000,http://frontend:3000

# External API Keys
EXTERNAL_API_KEYS=sk_dev_1234567890abcdef,sk_dev_fedcba0987654321

# ==========================================
# Frontend
# ==========================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ==========================================
# MinIO Object Storage
# ==========================================
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=net.public.p2p
MINIO_PUBLIC_URL=http://localhost:9000

# ==========================================
# Redis Cache
# ==========================================
REDIS_PORT=6379
REDIS_PASSWORD=redis123
